{
  "name": "polish",
  "version": "0.1.0",
  "description": "Visually edit CSS/HTML on your live page",
  "bin": {
    "polish": "./bin/polish"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "vite build && node bin/polish --proxy http://localhost:3000 --dir test-site",
    "prepublishOnly": "vite build"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "ws": "^8.20.0",
    "postcss": "^8.5.10",
    "htmlparser2": "^12.0.0",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.0.0",
    "vite": "^6.3.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.0"
  }
}
